    "test:contract": "node --test scripts/contract-test.mjs",
    "test:reliability": "node --test scripts/reliability-test.mjs",
    "test:local-workflows": "node scripts/local-workflows-test.mjs",
    "db:migrate": "node scripts/postgres-migrate.mjs",
    "test:postgres": "node --test scripts/postgres-test.mjs",
    "test:api": "node --test scripts/api-test.mjs",
    "api:start": "node backend/api/server.mjs",
    "test:hero-timeline": "node --test scripts/hero-timeline-test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.693.0",
